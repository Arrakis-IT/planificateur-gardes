# Copy to .env and adjust. Values below work as-is with `docker compose up` (dev).

# App
APP_ENV=development          # development | production
# ⚠️ DEV ONLY. In production, generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SECRET_KEY=dev-only-DO-NOT-USE-IN-PRODUCTION-replace-this-string-with-generated-one
# Public URL used in emailed links (production: https://gardes.arrakis.lu, enforced at startup)
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# DB
DATABASE_URL=postgresql+asyncpg://planificateur_gardes:planificateur_gardes@db:5432/planificateur_gardes
# Used by pytest (separate database, created by docker/postgres-init in dev)
TEST_DATABASE_URL=postgresql+asyncpg://planificateur_gardes:planificateur_gardes@db:5432/planificateur_gardes_test

# Bootstrap superadmin (created at startup only if no superadmin exists; must change the
# password at first login). ⚠️ DEV ONLY values: production refuses a "dev-only-" password.
INITIAL_SUPERADMIN_EMAIL=admin@example.lu
INITIAL_SUPERADMIN_PASSWORD=dev-only-admin-password
INITIAL_SUPERADMIN_NAME=Admin Dev

# Email (Brevo)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_SENDER_EMAIL=noreply@arrakis.lu
BREVO_SENDER_NAME=Planificateur des gardes

# Dev email override (Mailpit) — leave empty in production
MAIL_DEV_HOST=mailpit
MAIL_DEV_PORT=1025

# Cloudflare Turnstile
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry
# Empty = Sentry disabled. (Comments go on their own line: Docker Compose does not strip an
# inline comment after an empty value.)
SENTRY_DSN=

# Rate limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_RESET_PER_HOUR=3

# Session
SESSION_COOKIE_SECURE=false  # true in production (HTTPS)
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_DAYS=14

# Account lock: N failed logins within the window lock the account for that duration
LOGIN_LOCK_THRESHOLD=10
LOGIN_LOCK_MINUTES=15

# Password reset link validity
PASSWORD_RESET_TTL_MINUTES=60
